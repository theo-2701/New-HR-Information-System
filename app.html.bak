<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <title>SEVAKA HRIS — App</title>
  <meta name="viewport" content="width=1440">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="css/tokens.css">
  <link rel="stylesheet" href="css/app.css">
  <script src="https://unpkg.com/lucide@0.469.0/dist/umd/lucide.min.js"></script>
  <style>
    html, body { height: 100%; margin: 0; overflow: hidden; }
  </style>
</head>
<body data-screen="dashboard">

<!-- ========================= SIGN-IN SCREEN ========================= -->
<section class="screen" data-screen="signin">
  <div class="auth-bg">
    <div class="auth-card">
      <div class="brand">
        <div class="brand__s">S</div>
        <div class="brand__text">
          <span class="brand__name">SEVAKA</span>
          <span class="brand__sub">Human Resource Information System</span>
        </div>
      </div>

      <div class="auth-card__heading">
        <h2>Masuk dengan ID Karyawan</h2>
        <p>Pastikan perusahaan Anda sudah memiliki username perusahaan sebelum melakukan login dengan ID karyawan.</p>
      </div>

      <form class="auth-card__form" onsubmit="event.preventDefault(); window.goTo('dashboard');">
        <div class="field">
          <label class="field__label">Username Perusahaan<em>*</em></label>
          <input class="field__input" placeholder="Masukkan Username Perusahaan" value="perusahaan.id" autocomplete="organization">
        </div>
        <div class="field">
          <label class="field__label">Employee ID<em>*</em></label>
          <input class="field__input" placeholder="EMP-XXXX" value="EMP-2041" autocomplete="username">
        </div>
        <div class="field">
          <label class="field__label">Password<em>*</em></label>
          <input class="field__input" type="password" placeholder="Masukkan Password" value="••••••••" autocomplete="current-password">
        </div>

        <div class="auth-card__form-row">
          <label class="checkbox">
            <input type="checkbox" checked>
            <span class="checkbox__box"></span>
            Ingat saya
          </label>
          <a href="#">Lupa password?</a>
        </div>

        <button class="btn btn--primary" type="submit" style="width:100%;justify-content:center;height:44px;border-radius:999px">
          Masuk
        </button>
      </form>

      <div style="text-align:center;font:500 12px/1.4 var(--font-body);color:var(--fg-3)">
        Butuh akses? Hubungi <a href="#" style="color:var(--color-secondary-500);font-weight:600">Administrator HR</a> perusahaan Anda.
      </div>
    </div>
  </div>
</section>

<!-- ========================= APP SHELL ========================= -->
<section class="screen" data-screen="dashboard,employee,profile,time">
  <div class="app">

    <!-- Top nav -->
    <header class="topnav">
      <!-- Brand -->
      <div class="brand">
        <div class="brand__s">S</div>
        <div class="brand__text">
          <span class="brand__name">SEVAKA</span>
          <span class="brand__sub">Human Resource Information System</span>
        </div>
      </div>

      <div class="topnav__divider"></div>

      <!-- Product picker -->
      <div class="product-picker" id="productPicker">
        <button class="product-picker__btn" id="productPickerBtn" aria-haspopup="true" aria-expanded="false">
          <span class="product-picker__now" id="productNow">HRIS</span>
          <i data-lucide="chevron-down" class="product-picker__chev"></i>
        </button>
        <div class="product-menu" role="menu">
          <div class="product-menu__head">Produk SEVAKA</div>
          <button class="product-opt is-on" data-product="HRIS" role="menuitem">
            <span class="product-opt__icon"><i data-lucide="layout-dashboard"></i></span>
            <span class="product-opt__text">
              <span class="product-opt__name">HRIS <i data-lucide="check" class="product-opt__check"></i></span>
              <span class="product-opt__desc">Core HR — employee lifecycle</span>
            </span>
          </button>
          <button class="product-opt" data-product="Recruitment" role="menuitem">
            <span class="product-opt__icon"><i data-lucide="briefcase"></i></span>
            <span class="product-opt__text">
              <span class="product-opt__name">Recruitment</span>
              <span class="product-opt__desc">ATS &amp; onboarding pipeline</span>
            </span>
          </button>
          <button class="product-opt is-soon" disabled role="menuitem">
            <span class="product-opt__icon"><i data-lucide="line-chart"></i></span>
            <span class="product-opt__text">
              <span class="product-opt__name">Insights <span class="soon-badge">SOON</span></span>
              <span class="product-opt__desc">AI workforce analytics</span>
            </span>
          </button>
          <button class="product-opt is-soon" disabled role="menuitem">
            <span class="product-opt__icon"><i data-lucide="award"></i></span>
            <span class="product-opt__text">
              <span class="product-opt__name">Performance Mgmt <span class="soon-badge">SOON</span></span>
              <span class="product-opt__desc">Reviews, goals, calibration</span>
            </span>
          </button>
        </div>
      </div>

      <div class="topnav__spacer"></div>

      <!-- Search -->
      <div class="search">
        <i data-lucide="search"></i>
        <input placeholder="Cari karyawan, dokumen, atau menu…" aria-label="Pencarian">
      </div>

      <!-- AI pill -->
      <button class="pill-ai" type="button" aria-label="Summarize Data">
        <i data-lucide="sparkles"></i>SUMMARIZE DATA
      </button>

      <!-- Icon buttons -->
      <button class="icon-btn" aria-label="Notifikasi">
        <i data-lucide="bell"></i>
        <span class="dot" aria-hidden="true"></span>
      </button>
      <button class="icon-btn" aria-label="Bantuan">
        <i data-lucide="help-circle"></i>
      </button>

      <!-- User avatar -->
      <div class="avatar" title="Tessa Hartanto" style="cursor:pointer">TH</div>
    </header>

    <!-- Body: sidebar + main -->
    <div class="app__body">

      <!-- Sidebar -->
      <aside class="sidebar" aria-label="Navigasi utama">
        <button class="sidebar__item" data-go="dashboard" aria-label="Home">
          <i data-lucide="layout-dashboard"></i><span>Home</span>
        </button>
        <button class="sidebar__item" data-go="employee" aria-label="Employee">
          <i data-lucide="users"></i><span>Employee</span>
        </button>
        <button class="sidebar__item" data-go="time" aria-label="Time">
          <i data-lucide="clock"></i><span>Time</span>
        </button>
        <button class="sidebar__item" aria-label="Company">
          <i data-lucide="building-2"></i><span>Company</span>
        </button>
        <button class="sidebar__item" aria-label="Finance">
          <i data-lucide="credit-card"></i><span>Finance</span>
        </button>
        <button class="sidebar__item" aria-label="Payroll">
          <i data-lucide="wallet"></i><span>Payroll</span>
        </button>

        <div class="sidebar__divider"></div>

        <button class="sidebar__item" aria-label="Recruitment">
          <i data-lucide="briefcase"></i><span>Recruit</span>
        </button>
        <button class="sidebar__item" aria-label="Productivity">
          <i data-lucide="check-circle-2"></i><span>Productivity</span>
        </button>
        <button class="sidebar__item" aria-label="Integrations">
          <i data-lucide="puzzle"></i><span>Integrate</span>
        </button>

        <div class="sidebar__divider"></div>

        <button class="sidebar__item" aria-label="Settings">
          <i data-lucide="settings"></i><span>Settings</span>
        </button>
        <button class="sidebar__item" data-go="signin" aria-label="Logout">
          <i data-lucide="log-out"></i><span>Logout</span>
        </button>
      </aside>

      <!-- Main content -->
      <main class="app__main">

        <!-- ===== DASHBOARD ===== -->
        <div class="app__scroll" data-screen="dashboard">

          <!-- Hero banner -->
          <div class="hero">
            <div>
              <h1 class="hero__title">Selamat Datang, Tessa.</h1>
              <p class="hero__meta">
                Anda memiliki <b style="color:white">3 permintaan cuti</b> yang menunggu persetujuan,
                dan 2 kandidat baru bergabung ke pipeline hari ini.
              </p>
            </div>
            <div class="hero__cta">
              <button class="btn btn--light"><i data-lucide="calendar"></i>Lihat Kalender</button>
              <button class="btn" style="background:white;color:var(--color-secondary-700);box-shadow:none">
                <i data-lucide="zap"></i>Quick Actions
              </button>
            </div>
          </div>

          <!-- Stat cards -->
          <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:14px">
            <div class="card">
              <span class="stat__label">Total Karyawan</span>
              <span class="stat__value">1,284</span>
              <span class="stat__delta stat__delta--up">
                <i data-lucide="arrow-up"></i>24 bulan ini
              </span>
            </div>
            <div class="card">
              <span class="stat__label">Cuti Hari Ini</span>
              <span class="stat__value">14</span>
              <span class="stat__delta stat__delta--down">
                <i data-lucide="arrow-down"></i>2 vs kemarin
              </span>
            </div>
            <div class="card">
              <span class="stat__label">Menunggu Persetujuan</span>
              <span class="stat__value">37</span>
              <span class="stat__delta stat__delta--flat">Stabil</span>
            </div>
            <div class="card">
              <span class="stat__label">Posisi Terbuka</span>
              <span class="stat__value">9</span>
              <span class="stat__delta stat__delta--up">
                <i data-lucide="arrow-up"></i>2 minggu ini
              </span>
            </div>
          </div>

          <!-- Charts row -->
          <div style="display:grid;grid-template-columns:2fr 1fr;gap:14px">
            <!-- Attendance line chart -->
            <div class="card">
              <div class="card__head">
                <h3 class="card__title">Kehadiran — 7 Hari Terakhir</h3>
                <select style="height:30px;border:1px solid var(--border-1);border-radius:6px;padding:0 8px;font:500 12px/1 var(--font-body);color:var(--fg-2);background:white;cursor:pointer">
                  <option>Minggu ini</option>
                  <option>Minggu lalu</option>
                  <option>Bulan ini</option>
                </select>
              </div>
              <svg viewBox="0 0 600 180" style="width:100%;height:180px;display:block" aria-label="Grafik kehadiran">
                <defs>
                  <linearGradient id="chartFill" x1="0" x2="0" y1="0" y2="1">
                    <stop offset="0%" stop-color="#0284c7" stop-opacity=".25"/>
                    <stop offset="100%" stop-color="#0284c7" stop-opacity="0"/>
                  </linearGradient>
                </defs>
                <g stroke="#f1f5f9" stroke-width="1">
                  <line x1="0" y1="36"  x2="600" y2="36"/>
                  <line x1="0" y1="72"  x2="600" y2="72"/>
                  <line x1="0" y1="108" x2="600" y2="108"/>
                  <line x1="0" y1="144" x2="600" y2="144"/>
                </g>
                <path d="M 20 55 L 110 45 L 200 68 L 290 40 L 380 63 L 470 26 L 560 50 L 560 180 L 20 180 Z" fill="url(#chartFill)"/>
                <path d="M 20 55 L 110 45 L 200 68 L 290 40 L 380 63 L 470 26 L 560 50" fill="none" stroke="#0284c7" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M 20 150 L 110 145 L 200 140 L 290 152 L 380 135 L 470 147 L 560 140" fill="none" stroke="#f59e0b" stroke-width="2" stroke-dasharray="4 4" stroke-linecap="round"/>
                <g font-family="Inter, sans-serif" font-size="10" fill="#94a3b8" text-anchor="middle">
                  <text x="20"  y="175">Sen</text>
                  <text x="110" y="175">Sel</text>
                  <text x="200" y="175">Rab</text>
                  <text x="290" y="175">Kam</text>
                  <text x="380" y="175">Jum</text>
                  <text x="470" y="175">Sab</text>
                  <text x="560" y="175">Min</text>
                </g>
              </svg>
              <div style="display:flex;gap:16px;font:500 12px/1 var(--font-body);color:var(--fg-3)">
                <span>
                  <span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:#0284c7;vertical-align:middle;margin-right:4px"></span>
                  Hadir (rata-rata 1.232)
                </span>
                <span>
                  <span style="display:inline-block;width:10px;height:2px;background:#f59e0b;vertical-align:middle;margin-right:4px"></span>
                  Tidak Hadir (rata-rata 38)
                </span>
              </div>
            </div>

            <!-- Donut: workforce composition -->
            <div class="card">
              <div class="card__head">
                <h3 class="card__title">Komposisi Tenaga Kerja</h3>
                <span class="chip chip--info">1.284 total</span>
              </div>
              <div style="display:flex;align-items:center;gap:16px">
                <svg viewBox="0 0 100 100" style="width:120px;height:120px;flex-shrink:0" aria-label="Donut chart komposisi">
                  <circle cx="50" cy="50" r="42" fill="none" stroke="#f1f5f9" stroke-width="14"/>
                  <circle cx="50" cy="50" r="42" fill="none" stroke="#0284c7" stroke-width="14"
                          stroke-dasharray="163.4 263.9" transform="rotate(-90 50 50)"/>
                  <circle cx="50" cy="50" r="42" fill="none" stroke="#87ceeb" stroke-width="14"
                          stroke-dasharray="63.3 263.9" stroke-dashoffset="-163.4" transform="rotate(-90 50 50)"/>
                  <circle cx="50" cy="50" r="42" fill="none" stroke="#fde68a" stroke-width="14"
                          stroke-dasharray="37 263.9" stroke-dashoffset="-226.7" transform="rotate(-90 50 50)"/>
                  <text x="50" y="48" text-anchor="middle" font-family="Plus Jakarta Sans, sans-serif" font-weight="700" font-size="18" fill="#111827">62%</text>
                  <text x="50" y="62" text-anchor="middle" font-family="Inter, sans-serif" font-size="8" fill="#667085">Tetap</text>
                </svg>
                <div class="stack-3" style="font:500 12px/1.5 var(--font-body)">
                  <div><span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:#0284c7;margin-right:6px;vertical-align:middle"></span>Tetap · 796</div>
                  <div><span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:#87ceeb;margin-right:6px;vertical-align:middle"></span>Kontrak · 308</div>
                  <div><span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:#fde68a;margin-right:6px;vertical-align:middle"></span>Magang · 180</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Quick links + Announcements + Leave widgets -->
          <div style="display:grid;grid-template-columns:1fr 1.5fr 1fr;gap:14px">

            <!-- Quick links -->
            <div class="card">
              <div class="card__head"><h3 class="card__title">Quick Links</h3></div>
              <div class="quicklinks">
                <a class="quicklink" data-go="profile">
                  <div class="quicklink__icon"><i data-lucide="user"></i></div>
                  <div><div class="quicklink__name">Profil Saya</div><div class="quicklink__sub">Data personal</div></div>
                </a>
                <a class="quicklink">
                  <div class="quicklink__icon"><i data-lucide="file-text"></i></div>
                  <div><div class="quicklink__name">Formulir</div><div class="quicklink__sub">5 terbuka</div></div>
                </a>
                <a class="quicklink">
                  <div class="quicklink__icon"><i data-lucide="calendar-days"></i></div>
                  <div><div class="quicklink__name">Ajukan Cuti</div><div class="quicklink__sub">Sisa 12 hari</div></div>
                </a>
                <a class="quicklink">
                  <div class="quicklink__icon"><i data-lucide="wallet"></i></div>
                  <div><div class="quicklink__name">Slip Gaji</div><div class="quicklink__sub">Mei 2026</div></div>
                </a>
                <a class="quicklink">
                  <div class="quicklink__icon"><i data-lucide="award"></i></div>
                  <div><div class="quicklink__name">Kinerja</div><div class="quicklink__sub">Review tengah tahun</div></div>
                </a>
                <a class="quicklink">
                  <div class="quicklink__icon"><i data-lucide="megaphone"></i></div>
                  <div><div class="quicklink__name">Pengumuman</div><div class="quicklink__sub">3 baru</div></div>
                </a>
              </div>
            </div>

            <!-- Announcements / Tasks -->
            <div class="card">
              <div class="card__head">
                <div class="tabs" style="border:none;padding:0;gap:4px">
                  <button class="tabs__tab is-on">Pengumuman</button>
                  <button class="tabs__tab">Tugas · 4</button>
                  <button class="tabs__tab">Probation · 2</button>
                </div>
              </div>
              <div class="stack-3">
                <div style="display:flex;gap:12px;padding:12px;border:1px solid var(--border-1);border-radius:12px;background:var(--color-mist)">
                  <div class="quicklink__icon" style="background:var(--color-tertiary-200);border-color:var(--color-tertiary-500);color:var(--color-tertiary-900);flex-shrink:0">
                    <i data-lucide="megaphone"></i>
                  </div>
                  <div style="flex:1;min-width:0">
                    <div style="font:700 13px/1.2 var(--font-body);color:var(--fg-1)">Hari Libur: Hari Raya Waisak</div>
                    <div style="font:500 12px/1.4 var(--font-body);color:var(--fg-3);margin-top:4px">
                      Kantor tutup Jumat, 22 Mei 2026. Permintaan cuti di sekitar tanggal tersebut akan diprioritaskan.
                    </div>
                    <div style="display:flex;gap:12px;margin-top:8px;font:500 11px/1 var(--font-body);color:var(--fg-3)">
                      <span>People Operations</span>
                      <span>·</span>
                      <span>2 hari lalu</span>
                    </div>
                  </div>
                </div>
                <div style="display:flex;gap:12px;padding:12px;border:1px solid var(--border-1);border-radius:12px">
                  <div class="quicklink__icon" style="flex-shrink:0"><i data-lucide="award"></i></div>
                  <div style="flex:1;min-width:0">
                    <div style="font:700 13px/1.2 var(--font-body);color:var(--fg-1)">Review Kinerja Tengah Tahun Dibuka</div>
                    <div style="font:500 12px/1.4 var(--font-body);color:var(--fg-3);margin-top:4px">
                      Semua laporan langsung harus diselesaikan sebelum 30 Jun 2026. Sistem akan mengingatkan setiap minggu.
                    </div>
                    <div style="margin-top:8px">
                      <button class="btn btn--ghost">Buka review →</button>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Leave balance + Who's off -->
            <div class="col">
              <div class="card">
                <div class="card__head">
                  <h3 class="card__title">Sisa Cuti Sakit</h3>
                  <span class="chip chip--info">Anda</span>
                </div>
                <div class="between" style="font:500 12px/1 var(--font-body);color:var(--fg-3)">
                  <span>Terpakai</span><span>2 dari 12 hari</span>
                </div>
                <div class="bar"><span style="width:16%"></span></div>
                <button class="btn btn--primary" style="height:32px;width:fit-content">
                  <i data-lucide="plus"></i>Ajukan Cuti Sakit
                </button>
              </div>

              <div class="card">
                <div class="card__head"><h3 class="card__title">Yang Tidak Masuk Hari Ini</h3></div>
                <div>
                  <div class="whoisoff__row">
                    <div class="avatar avatar--sm" style="background:#fde68a;color:#72673e">RM</div>
                    <div class="whoisoff__meta">
                      <div class="whoisoff__name">Reza Maulana</div>
                      <div class="whoisoff__sub">Cuti tahunan · kembali Rabu</div>
                    </div>
                  </div>
                  <div class="whoisoff__row">
                    <div class="avatar avatar--sm" style="background:#34d399">AP</div>
                    <div class="whoisoff__meta">
                      <div class="whoisoff__name">Anita Pranata</div>
                      <div class="whoisoff__sub">Sakit · hari ini</div>
                    </div>
                  </div>
                  <div class="whoisoff__row">
                    <div class="avatar avatar--sm" style="background:#ef4444">SS</div>
                    <div class="whoisoff__meta">
                      <div class="whoisoff__name">Surya Setiawan</div>
                      <div class="whoisoff__sub">WFH</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- ===== EMPLOYEE MANAGEMENT ===== -->
        <div class="app__scroll" data-screen="employee" style="display:none;padding:0">
          <!-- Hero -->
          <div style="padding:16px 24px 0">
            <div class="hero" style="min-height:96px">
              <div>
                <h1 class="hero__title" style="font-size:24px">Manajemen Karyawan</h1>
                <p class="hero__meta">Kelola data karyawan, struktur organisasi, dan riwayat employment.</p>
              </div>
              <div class="hero__cta">
                <button class="btn btn--light"><i data-lucide="upload"></i>Import</button>
                <button class="btn" style="background:white;color:var(--color-secondary-700);box-shadow:none">
                  <i data-lucide="user-plus"></i>Tambah Karyawan
                </button>
              </div>
            </div>
          </div>

          <div style="padding:14px 24px 32px">
            <div class="card" style="padding:0;gap:0">
              <!-- Tabs -->
              <div class="tabs">
                <button class="tabs__tab is-on">Direktori</button>
                <button class="tabs__tab">Organisasi</button>
                <button class="tabs__tab">Teguran</button>
                <button class="tabs__tab">Pengunduran Diri</button>
                <button class="tabs__tab">Manpower Planning</button>
              </div>

              <!-- Toolbar -->
              <div class="toolbar">
                <div class="search" style="height:32px">
                  <i data-lucide="search"></i>
                  <input placeholder="Cari nama, ID, atau email" aria-label="Cari karyawan">
                </div>
                <button class="btn btn--secondary" style="height:32px">
                  <i data-lucide="filter"></i>Departemen · Semua
                </button>
                <button class="btn btn--secondary" style="height:32px">
                  <i data-lucide="filter"></i>Status · Aktif
                </button>
                <span class="toolbar__spacer"></span>
                <span class="muted" style="font:500 12px/1 var(--font-body)">1.284 hasil</span>
                <button class="btn btn--secondary btn--icon" aria-label="Export">
                  <i data-lucide="download"></i>
                </button>
                <button class="btn btn--primary" style="height:32px">
                  <i data-lucide="plus"></i>Baru
                </button>
              </div>

              <!-- Table -->
              <table class="table">
                <thead>
                  <tr>
                    <th style="width:40px">
                      <label class="checkbox" style="margin:0">
                        <input type="checkbox" aria-label="Pilih semua">
                        <span class="checkbox__box"></span>
                      </label>
                    </th>
                    <th>Karyawan</th>
                    <th>Jabatan</th>
                    <th>Departemen</th>
                    <th>Status</th>
                    <th>Tanggal Mulai</th>
                    <th style="width:40px"></th>
                  </tr>
                </thead>
                <tbody id="empTbody"></tbody>
              </table>

              <div class="pagination">
                <span>Menampilkan 1–8 dari 1.284</span>
                <div class="pagination__controls">
                  <button class="pagination__btn" aria-label="Sebelumnya">‹</button>
                  <button class="pagination__btn is-on">1</button>
                  <button class="pagination__btn">2</button>
                  <button class="pagination__btn">3</button>
                  <button class="pagination__btn" disabled>…</button>
                  <button class="pagination__btn">161</button>
                  <button class="pagination__btn" aria-label="Berikutnya">›</button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- ===== EMPLOYEE PROFILE ===== -->
        <div class="app__scroll" data-screen="profile" style="display:none">
          <div style="display:grid;grid-template-columns:280px 1fr;gap:16px">

            <!-- Left: summary card -->
            <div class="card">
              <div style="display:flex;flex-direction:column;align-items:center;gap:10px;padding:8px 0">
                <div class="avatar avatar--xl">TH</div>
                <div style="text-align:center">
                  <div style="font:700 18px/1.2 var(--font-display);color:var(--fg-1)">Tessa Hartanto</div>
                  <div style="font:500 12px/1.4 var(--font-body);color:var(--fg-3)">Senior Designer · People Operations</div>
                </div>
                <span class="chip chip--ok">Aktif</span>
              </div>

              <div class="stack-3" style="border-top:1px solid var(--border-1);padding-top:14px">
                <div class="between" style="font:500 12px/1.4 var(--font-body)">
                  <span class="muted">Employee ID</span><span>EMP-2041</span>
                </div>
                <div class="between" style="font:500 12px/1.4 var(--font-body)">
                  <span class="muted">Email</span><span style="font-size:11px">tessa.h@perusahaan.id</span>
                </div>
                <div class="between" style="font:500 12px/1.4 var(--font-body)">
                  <span class="muted">Telepon</span><span>+62 812‑4471‑0099</span>
                </div>
                <div class="between" style="font:500 12px/1.4 var(--font-body)">
                  <span class="muted">Manajer</span><span>R. Wirajaya</span>
                </div>
                <div class="between" style="font:500 12px/1.4 var(--font-body)">
                  <span class="muted">Bergabung</span><span>12 Jan 2023</span>
                </div>
              </div>

              <button class="btn btn--secondary" style="width:100%;justify-content:center">
                <i data-lucide="pencil"></i>Edit Profil
              </button>
            </div>

            <!-- Right: tabbed form -->
            <div class="card" style="padding:0">
              <div class="tabs" style="padding:0 16px">
                <button class="tabs__tab is-on">Data Personal</button>
                <button class="tabs__tab">Kepegawaian</button>
                <button class="tabs__tab">Identitas &amp; Alamat</button>
                <button class="tabs__tab">Info Penggajian</button>
                <button class="tabs__tab">Bank</button>
                <button class="tabs__tab">BPJS</button>
                <button class="tabs__tab">Pajak</button>
              </div>

              <div style="padding:20px 24px;display:grid;grid-template-columns:1fr 1fr;gap:16px 24px">
                <div class="field">
                  <label class="field__label">Nama Lengkap</label>
                  <input class="field__input" value="Tessa Hartanto">
                </div>
                <div class="field">
                  <label class="field__label">Nama Panggilan</label>
                  <input class="field__input" value="Tessa">
                </div>
                <div class="field">
                  <label class="field__label">Tanggal Lahir</label>
                  <input class="field__input" value="04 / 08 / 1995">
                </div>
                <div class="field">
                  <label class="field__label">Jenis Kelamin</label>
                  <input class="field__input" value="Perempuan">
                </div>
                <div class="field">
                  <label class="field__label">Status Pernikahan</label>
                  <input class="field__input" value="Belum Menikah">
                </div>
                <div class="field">
                  <label class="field__label">Agama</label>
                  <input class="field__input" value="Islam">
                </div>
                <div class="field">
                  <label class="field__label">Email</label>
                  <input class="field__input" value="tessa.h@perusahaan.id" type="email">
                  <span class="field__help">Your email address is your identity on SEVAKA.</span>
                </div>
                <div class="field">
                  <label class="field__label">No. Telepon</label>
                  <input class="field__input" value="+62 812-4471-0099" type="tel">
                </div>
                <div class="field" style="grid-column:span 2">
                  <label class="field__label">Alamat Tinggal</label>
                  <input class="field__input" value="Jl. Gatot Subroto Kav. 27, Jakarta Selatan 12950">
                </div>
              </div>

              <div style="padding:14px 24px;border-top:1px solid var(--border-1);display:flex;gap:8px;justify-content:flex-end">
                <button class="btn btn--secondary">Batal</button>
                <button class="btn btn--primary">Simpan Perubahan</button>
              </div>
            </div>
          </div>
        </div>

        <!-- ===== TIME MANAGEMENT ===== -->
        <div class="app__scroll" data-screen="time" style="display:none">
          <div style="display:grid;grid-template-columns:320px 1fr;gap:16px">

            <!-- Left: clock-in + leave balance -->
            <div class="col">
              <div class="clockin">
                <span style="font:700 11px/1 var(--font-body);letter-spacing:.04em;text-transform:uppercase;color:var(--color-primary-200)">
                  Hari Ini · Kamis
                </span>
                <div class="clockin__time" id="liveClock">09:42</div>
                <div class="clockin__date">21 Mei 2026 · Kantor Jakarta</div>
                <div class="clockin__row">
                  <button class="btn" style="background:white;color:var(--color-secondary-700);box-shadow:none;flex:1;justify-content:center">
                    <i data-lucide="log-in"></i>Clock In
                  </button>
                  <button class="btn btn--light btn--icon" aria-label="Opsi lain">
                    <i data-lucide="more-horizontal"></i>
                  </button>
                </div>
                <div style="font:500 12px/1.4 var(--font-body);color:var(--color-primary-200);border-top:1px solid rgba(255,255,255,.16);padding-top:12px">
                  Anda dijadwalkan masuk 09:00 – 18:00. Klik <b style="color:white">Clock In</b> untuk mencatat kehadiran.
                </div>
              </div>

              <div class="card">
                <div class="card__head"><h3 class="card__title">Saldo Cuti Saya</h3></div>
                <div class="stack-3">
                  <div>
                    <div class="between" style="font:500 12px/1 var(--font-body);color:var(--fg-3);margin-bottom:6px">
                      <span>Tahunan</span><span>9 / 12 hari</span>
                    </div>
                    <div class="bar"><span style="width:75%"></span></div>
                  </div>
                  <div>
                    <div class="between" style="font:500 12px/1 var(--font-body);color:var(--fg-3);margin-bottom:6px">
                      <span>Sakit</span><span>10 / 12 hari</span>
                    </div>
                    <div class="bar"><span style="width:83%;background:linear-gradient(90deg,#fde68a,#f59e0b)"></span></div>
                  </div>
                  <div>
                    <div class="between" style="font:500 12px/1 var(--font-body);color:var(--fg-3);margin-bottom:6px">
                      <span>Duka Cita</span><span>3 / 3 hari</span>
                    </div>
                    <div class="bar"><span style="width:100%;background:linear-gradient(90deg,#34d399,#1f7f5c)"></span></div>
                  </div>
                </div>
                <button class="btn btn--primary" style="width:100%;justify-content:center">
                  <i data-lucide="calendar-plus"></i>Ajukan Cuti
                </button>
              </div>
            </div>

            <!-- Right: calendar -->
            <div class="card">
              <div class="card__head">
                <h3 class="card__title">Mei 2026</h3>
                <div style="display:flex;gap:6px;align-items:center">
                  <button class="icon-btn" aria-label="Bulan sebelumnya"><i data-lucide="chevron-left"></i></button>
                  <button class="btn btn--secondary" style="height:32px">Hari ini</button>
                  <button class="icon-btn" aria-label="Bulan berikutnya"><i data-lucide="chevron-right"></i></button>
                </div>
              </div>

              <div class="calendar">
                <div class="calendar__grid">
                  <div class="calendar__head">Sen</div>
                  <div class="calendar__head">Sel</div>
                  <div class="calendar__head">Rab</div>
                  <div class="calendar__head">Kam</div>
                  <div class="calendar__head">Jum</div>
                  <div class="calendar__head">Sab</div>
                  <div class="calendar__head">Min</div>
                </div>
                <div class="calendar__grid" id="cal"></div>
              </div>

              <div style="display:flex;gap:16px;font:500 12px/1 var(--font-body);color:var(--fg-3);padding-top:8px;border-top:1px solid var(--border-1)">
                <span>
                  <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#0284c7;vertical-align:middle;margin-right:4px"></span>
                  Cuti disetujui
                </span>
                <span>
                  <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#f59e0b;vertical-align:middle;margin-right:4px"></span>
                  Permintaan tertunda
                </span>
                <span>
                  <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#34d399;vertical-align:middle;margin-right:4px"></span>
                  Hari libur
                </span>
              </div>
            </div>
          </div>
        </div>

      </main>
    </div>
  </div>
</section>

<script src="js/app.js"></script>
</body>
</html>
