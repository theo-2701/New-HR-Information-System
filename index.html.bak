<!-- ==================== LOGIN PAGE ==================== -->
<div class="auth-page">
  <div class="auth-page__left">
    <div class="brand auth-brand">
      <div class="brand__s" style="width:56px;height:56px;font-size:32px">S</div>
      <div class="brand__name" style="font-size:22px;color:white">SEVAKA</div>
    </div>

    <div class="auth-hero" style="position:relative;max-width:480px">
      <h2>Selamat Datang Kembali</h2>
      <p>Masuk ke SEVAKA HRIS untuk mengelola HR perusahaan Anda. Gunakan akun karyawan atau admin HR Anda.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap">
        <button class="btn-primary-pill" style="background:white;color:var(--color-secondary-700);box-shadow:none">
          HRIS Login
        </button>
        <button class="btn-light-pill" style="height:40px">
          HRCM Login
        </button>
      </div>
    </div>

    <div style="font:500 12px/1.6 var(--font-body);color:rgba(255,255,255,.5)">
      Butuh demo atau akun baru?<br>
      <a href="#" style="color:var(--color-primary-400,#87ceeb);font-weight:600;text-decoration:none">Hubungi tim penjualan kami →</a>
    </div>
  </div>

  <div class="auth-page__right">
    <div class="auth-form">
      <div>
        <h3>Masuk ke SEVAKA</h3>
        <p class="sub-text">Masukkan username perusahaan dan ID karyawan Anda.</p>
      </div>

      <form onsubmit="event.preventDefault(); window.open('app.html','_self');">
        <div class="field">
          <label>Username Perusahaan</label>
          <input type="text" placeholder="contoh: perusahaan.id" autocomplete="organization">
        </div>
        <div class="field" style="margin-top:12px">
          <label>Employee ID</label>
          <input type="text" placeholder="EMP-XXXX" autocomplete="username">
        </div>
        <div class="field" style="margin-top:12px">
          <label>Password</label>
          <input type="password" placeholder="Masukkan password Anda" autocomplete="current-password">
        </div>

        <div class="row-inline" style="margin-top:12px">
          <label class="checkbox-mini">
            <input type="checkbox" checked>
            <span class="box"></span>
            Ingat saya
          </label>
          <a href="#">Lupa password?</a>
        </div>

        <button class="btn-submit" type="submit" style="margin-top:16px">Masuk</button>
      </form>

      <p class="alt">
        Kembali ke <a href="#" onclick="document.body.dataset.view='home'; return false;">halaman utama</a>
      </p>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (window.lucide) lucide.createIcons({ attrs: { 'stroke-width': 1.75 } });
  });
</script>
